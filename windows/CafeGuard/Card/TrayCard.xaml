<Window x:Class="CafeGuard.Card.TrayCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cafe Guard"
        Width="354" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Pop-up card shown when the tray shield is clicked (spec §6, mockup design-preview-v2). -->
    <Border x:Name="Frame" Style="{DynamicResource CardBorder}" Margin="12" Padding="16">
        <StackPanel>

            <!-- Header: shield, title, subtitle, theme switch -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path x:Name="ShieldIcon" Width="40" Height="46" Stretch="Fill" Margin="0,0,12,0"
                      Data="{DynamicResource ShieldGeometry}" Fill="{DynamicResource Brush.Green}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{DynamicResource TitleText}" TextWrapping="Wrap" Text="Cafe Guard is OFF" />
                    <TextBlock x:Name="SubtitleText" Style="{DynamicResource SubtitleText}" Margin="0,2,0,0" Text="Your laptop is not guarded" />
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0" Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="2"
                        ToolTip="Light or dark (Auto follows Windows)">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeAuto" Style="{DynamicResource SegmentButton}" GroupName="Theme" Content="Auto" />
                        <RadioButton x:Name="ThemeLight" Style="{DynamicResource SegmentButton}" GroupName="Theme" Content="☀" />
                        <RadioButton x:Name="ThemeDark" Style="{DynamicResource SegmentButton}" GroupName="Theme" Content="🌙" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alarm reason (ALARM only) -->
            <Border x:Name="AlarmBar" Margin="0,12,0,0" Background="{DynamicResource Brush.RedSoft}" CornerRadius="6" Padding="10,8" Visibility="Collapsed">
                <TextBlock x:Name="AlarmBarText" Style="{DynamicResource BodyText}" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Red}" Text="⚠ Charger was unplugged" />
            </Border>

            <!-- Big button -->
            <Button x:Name="BigButton" Margin="0,14,0,0" Style="{DynamicResource PrimaryButton}" Content="🔒 Turn ON — going to bathroom" />

            <!-- Checklist chips -->
            <StackPanel x:Name="ChipsPanel" Margin="0,14,0,0" />

            <!-- Win+L switch -->
            <Border x:Name="ArmOnLockRow" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,6,0,0">
                <DockPanel>
                    <CheckBox x:Name="ArmOnLockSwitch" DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource BodyText}" FontSize="12.5" Text="🔐" Foreground="{DynamicResource Brush.GreenText}" Margin="0,0,6,0" />
                            <TextBlock Style="{DynamicResource BodyText}" FontSize="12.5" Text="Turn ON when I lock (Win+L)" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource SubtitleText}" FontSize="11.5" Margin="0,2,0,0" Text="Unlocking always turns it OFF" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Alarm sound (OFF only): Siren | Voice | Both, then the words and the voice -->
            <Border x:Name="SoundRow" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SoundSiren" Style="{DynamicResource SegmentButton}" GroupName="Sound" Content="Siren" />
                                <RadioButton x:Name="SoundVoice" Style="{DynamicResource SegmentButton}" GroupName="Sound" Content="Voice" />
                                <RadioButton x:Name="SoundBoth" Style="{DynamicResource SegmentButton}" GroupName="Sound" Content="Both" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource BodyText}" FontSize="12.5" Text="🔊" Foreground="{DynamicResource Brush.GreenText}" Margin="0,0,6,0" />
                            <TextBlock Style="{DynamicResource BodyText}" FontSize="12.5" Text="Alarm sound" />
                        </StackPanel>
                    </DockPanel>
                    <Grid x:Name="WordsPanel" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PhraseBox" Style="{DynamicResource SelectBox}" ToolTip="What the voice says" />
                        <ComboBox x:Name="VoiceBox" Grid.Column="2" Style="{DynamicResource SelectBox}" ToolTip="Man's or woman's voice" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <DockPanel Margin="0,12,0,0">
                <Button x:Name="ExitButton" DockPanel.Dock="Right" Style="{DynamicResource LinkButton}" Content="Exit" />
                <Button x:Name="TestSirenButton" HorizontalAlignment="Left" Style="{DynamicResource LinkButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔊" Foreground="{DynamicResource Brush.GreenText}" Margin="0,0,6,0" />
                        <TextBlock Text="Test siren" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
