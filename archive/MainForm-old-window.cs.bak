using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Windows.Forms;
using Microsoft.Win32;

namespace CafeGuard
{
    public enum GuardState
    {
        Disarmed,
        Armed,
        AlarmTriggered
    }

    public class MainForm : Form
    {
        private GuardState _state = GuardState.Disarmed;
        private string _armedPin = "1234";
        private AudioDeviceSnapshot? _armedAudioSnapshot;
        private readonly SirenPlayer _siren = new SirenPlayer();
        private readonly System.Windows.Forms.Timer _monitorTimer;
        private readonly System.Windows.Forms.Timer _testSirenTimer;
        private bool _isWindowsLocked = false;
        private bool _flashToggle = false;
        private string _triggerReason = string.Empty;

        // System Tray
        private readonly NotifyIcon _trayIcon;
        private readonly ContextMenuStrip _trayMenu;
        private Icon? _iconDisarmed;
        private Icon? _iconArmed;
        private Icon? _iconAlarm;

        // UI Controls
        private Panel _headerPanel = null!;
        private Label _statusBadgeLabel = null!;
        private Label _statusSubLabel = null!;
        private Label _powerStatusLabel = null!;
        private Label _audioStatusLabel = null!;
        private Label _lockScreenStatusLabel = null!;

        // Settings checkboxes
        private CheckBox _chkAntiMute = null!;
        private CheckBox _chkHeadphoneTrap = null!;
        private CheckBox _chkAutoLockOnArm = null!;
        private CheckBox _chkAutoLockOnTrigger = null!;
        private CheckBox _chkAutoDisarmOnWinUnlock = null!;

        // PIN & Action Controls
        private TextBox _txtPin = null!;
        private Button _btnArmAndLock = null!;
        private Button _btnArmOnly = null!;
        private Button _btnDisarm = null!;
        private Button _btnTestSiren = null!;
        private Button _btnHideToTray = null!;
        private ListBox _logBox = null!;

        public MainForm()
        {
            Text = "CafeGuard — Laptop Anti-Theft Charger & Lock-Screen Alarm";
            Size = new Size(620, 720);
            MinimumSize = new Size(600, 680);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor = Color.FromArgb(18, 22, 31);
            ForeColor = Color.FromArgb(235, 240, 248);
            Font = new Font("Segoe UI", 9.75f, FontStyle.Regular);
            FormBorderStyle = FormBorderStyle.FixedSingle;
            MaximizeBox = false;

            CreateDynamicIcons();
            if (_iconDisarmed != null) Icon = _iconDisarmed;

            // System Tray setup
            _trayMenu = BuildTrayMenu();
            _trayIcon = new NotifyIcon
            {
                Icon = _iconDisarmed,
                Text = "CafeGuard: DISARMED",
                ContextMenuStrip = _trayMenu,
                Visible = true
            };
            _trayIcon.DoubleClick += (_, _) => RestoreFromTray();

            BuildUI();

            // Monitor timer (runs every 150ms, even when Windows Lock Screen is active)
            _monitorTimer = new System.Windows.Forms.Timer { Interval = 150 };
            _monitorTimer.Tick += MonitorTimer_Tick;
            _monitorTimer.Start();

            // 3-second test siren timer
            _testSirenTimer = new System.Windows.Forms.Timer { Interval = 3000 };
            _testSirenTimer.Tick += (_, _) =>
            {
                _testSirenTimer.Stop();
                if (_state == GuardState.Disarmed)
                {
                    _siren.Stop();
                    CoreAudioController.RestoreVolume(_armedAudioSnapshot);
                    Log("Test siren finished (volume restored).");
                }
            };

            // Listen for Windows Lock Screen (Win+L) events
            SystemEvents.SessionSwitch += SystemEvents_SessionSwitch;

            Log("CafeGuard initialized. Ready for coffee shop protection.");
            UpdateTelemetryLabels();
            UpdateUiState();
        }

        private void CreateDynamicIcons()
        {
            _iconDisarmed = DrawShieldIcon(Color.FromArgb(16, 185, 129)); // Emerald Green
            _iconArmed = DrawShieldIcon(Color.FromArgb(59, 130, 246));    // Royal Blue
            _iconAlarm = DrawShieldIcon(Color.FromArgb(239, 68, 68));     // Crimson Red
        }

        private static Icon DrawShieldIcon(Color fillColor)
        {
            using var bmp = new Bitmap(32, 32);
            using var g = Graphics.FromImage(bmp);
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.Clear(Color.Transparent);

            Point[] shieldPts =
            {
                new Point(16, 2),
                new Point(28, 7),
                new Point(26, 20),
                new Point(16, 30),
                new Point(6, 20),
                new Point(4, 7)
            };

            using var brush = new SolidBrush(fillColor);
            using var pen = new Pen(Color.White, 2f);
            g.FillPolygon(brush, shieldPts);
            g.DrawPolygon(pen, shieldPts);

            // Draw lightning bolt inside shield
            using var boltFont = new Font("Segoe UI", 12f, FontStyle.Bold);
            var sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center };
            g.DrawString("⚡", boltFont, Brushes.White, new RectangleF(0, 2, 32, 28), sf);

            return Icon.FromHandle(bmp.GetHicon());
        }

        private ContextMenuStrip BuildTrayMenu()
        {
            var menu = new ContextMenuStrip();
            var itemArmLock = new ToolStripMenuItem("🔒 Arm & Lock Screen (Going to WC)", null, (_, _) => ArmSystem(lockScreenImmediately: true));
            var itemArmOnly = new ToolStripMenuItem("🛡️ Arm Alarm Only", null, (_, _) => ArmSystem(lockScreenImmediately: false));
            var itemTest = new ToolStripMenuItem("🔊 Test Siren (3 Seconds)", null, (_, _) => RunTestSiren());
            var itemShow = new ToolStripMenuItem("🖥️ Open CafeGuard Dashboard", null, (_, _) => RestoreFromTray());
            var itemExit = new ToolStripMenuItem("❌ Exit CafeGuard", null, (_, _) =>
            {
                if (_state != GuardState.Disarmed)
                {
                    RestoreFromTray();
                    MessageBox.Show(
                        "CafeGuard is currently ARMED! Enter your PIN to disarm before exiting.",
                        "CafeGuard Security Lock",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);
                    return;
                }
                ExitApplication();
            });

            menu.Items.Add(itemArmLock);
            menu.Items.Add(itemArmOnly);
            menu.Items.Add(new ToolStripSeparator());
            menu.Items.Add(itemTest);
            menu.Items.Add(itemShow);
            menu.Items.Add(new ToolStripSeparator());
            menu.Items.Add(itemExit);
            return menu;
        }

