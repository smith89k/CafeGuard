        private void ArmSystem(bool lockScreenImmediately)
        {
            if (_state != GuardState.Disarmed) return;

            string pin = _txtPin.Text.Trim();
            if (pin.Length < 3)
            {
                MessageBox.Show(
                    "Please enter a secret PIN code (at least 3 digits/characters) before arming.",
                    "PIN Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);
                _txtPin.Focus();
                return;
            }

            var power = PowerAndLockService.GetPowerStatus();
            if (!power.IsPluggedIn)
            {
                var res = MessageBox.Show(
                    "Your laptop charger is currently UNPLUGGED!\n\n" +
                    "If you arm CafeGuard right now while unplugged, the siren will trigger immediately.\n\n" +
                    "Do you want to arm anyway (to test the alarm trigger)?",
                    "Charger Not Plugged In",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

                if (res != DialogResult.Yes) return;
            }

            _armedPin = pin;
            _txtPin.Text = string.Empty; // Clear PIN box so nobody can read length
            _armedAudioSnapshot = CoreAudioController.TakeSnapshot();
            _triggerReason = string.Empty;
            _state = GuardState.Armed;

            if (_chkAutoLockOnArm.Checked)
            {
                PowerAndLockService.SetKeepAwakeOnLockScreen(true);
            }

            UpdateUiState();
            Log($"ARMED protection. Audio locked to: {_armedAudioSnapshot.DefaultDeviceName}.");

            _trayIcon.ShowBalloonTip(
                2000,
                "CafeGuard ARMED",
                "Unplugging the charger or plugging in headphones will trigger the 100% volume siren.",
                ToolTipIcon.Info);

            if (lockScreenImmediately)
            {
                Log("Locking Windows screen (Win+L) for WC break...");
                PowerAndLockService.LockWorkStation();
            }
        }

        private void TriggerAlarm(string reason)
        {
            if (_state == GuardState.AlarmTriggered) return;

            _state = GuardState.AlarmTriggered;
            _triggerReason = reason;
            Log($"🚨 ALARM TRIGGERED: {reason}");

            // 1. Force 100% volume & unmute immediately
            if (_chkAntiMute.Checked)
            {
                CoreAudioController.EnforceMaxVolumeAndAntiHijack(_armedAudioSnapshot);
            }

            // 2. Start high-decibel piercing siren
            _siren.StartLooping();

            // 3. Bring window to front & update UI
            UpdateUiState();

            // 4. Lock Windows screen if configured and not already locked
            if (_chkAutoLockOnTrigger.Checked && !_isWindowsLocked)
            {
                PowerAndLockService.LockWorkStation();
            }
        }

        private void TryDisarmWithPin()
        {
            string entered = _txtPin.Text.Trim();
            if (entered == _armedPin)
            {
                DisarmSystem("Correct PIN entered by owner.");
            }
            else
            {
                _txtPin.Text = string.Empty;
                _txtPin.Focus();
                Log("❌ Failed disarm attempt: Wrong PIN entered!");
                if (_state == GuardState.Armed)
                {
                    TriggerAlarm("Wrong PIN entered while armed!");
                }
            }
        }

        private void DisarmSystem(string reason)
        {
            _siren.Stop();
            _state = GuardState.Disarmed;
            _triggerReason = string.Empty;
            _txtPin.Text = _armedPin; // Restore PIN for quick re-arming
            TopMost = false;

            PowerAndLockService.SetKeepAwakeOnLockScreen(false);
            CoreAudioController.RestoreVolume(_armedAudioSnapshot);

            Log($"🟢 DISARMED: {reason}");
            UpdateUiState();
        }

        private void RunTestSiren()
        {
            if (_state != GuardState.Disarmed) return;
            _armedAudioSnapshot = CoreAudioController.TakeSnapshot();
            Log("🔊 Running 3-second max-volume siren test...");
            CoreAudioController.EnforceMaxVolumeAndAntiHijack(_armedAudioSnapshot);
            _siren.StartLooping();
            _testSirenTimer.Start();
        }

        private void MonitorTimer_Tick(object? sender, EventArgs e)
        {
            UpdateTelemetryLabels();

            if (_state == GuardState.Armed)
            {
                // 1. Check if charger was unplugged
                var power = PowerAndLockService.GetPowerStatus();
                if (!power.IsPluggedIn)
                {
                    TriggerAlarm("AC Charger Unplugged!");
                    return;
                }

                // 2. Check Headphone / Audio-Jack Trap
                if (_chkHeadphoneTrap.Checked && _armedAudioSnapshot != null)
                {
                    if (CoreAudioController.HasAudioEndpointChanged(_armedAudioSnapshot, out string audioReason))
                    {
                        TriggerAlarm(audioReason);
                        return;
                    }
                }
            }
            else if (_state == GuardState.AlarmTriggered)
            {
                // Continuously enforce 100% Volume, Unmute, and Anti-Headphone-Hijack every 150ms!
                if (_chkAntiMute.Checked)
                {
                    CoreAudioController.EnforceMaxVolumeAndAntiHijack(_armedAudioSnapshot);
                }

                // Ensure siren keeps looping
                if (!_siren.IsPlaying)
                {
                    _siren.StartLooping();
                }

                // Flash banner red/dark-red
                _flashToggle = !_flashToggle;
                _headerPanel.BackColor = _flashToggle
                    ? Color.FromArgb(220, 38, 38)
                    : Color.FromArgb(127, 29, 29);
            }
        }

        private void SystemEvents_SessionSwitch(object sender, SessionSwitchEventArgs e)
        {
            if (e.Reason == SessionSwitchReason.SessionLock)
            {
                _isWindowsLocked = true;
                Log("🔒 Windows Lock Screen engaged — CafeGuard monitoring in background.");
            }
            else if (e.Reason == SessionSwitchReason.SessionUnlock)
            {
                _isWindowsLocked = false;
                Log("🔓 Windows Screen unlocked.");

                if (_state == GuardState.Armed && _chkAutoDisarmOnWinUnlock.Checked)
                {
                    DisarmSystem("Auto-disarmed on owner Windows Unlock.");
                }
                else if (_state != GuardState.Disarmed)
                {
                    // Pop up disarm window immediately when owner unlocks screen
                    RestoreFromTray();
                    TopMost = true;
                    Activate();
                    _txtPin.Focus();
                }
            }
        }

        private void UpdateTelemetryLabels()
        {
            var power = PowerAndLockService.GetPowerStatus();
            _powerStatusLabel.Text = $"🔌 Power: {power.StatusText}";
            _powerStatusLabel.ForeColor = power.IsPluggedIn
                ? Color.FromArgb(74, 222, 128)
                : Color.FromArgb(248, 113, 113);

            var audio = CoreAudioController.GetCurrentAudioStatus();
            string muteTxt = audio.IsMuted ? "MUTED" : $"{audio.VolumePercent}%";
            _audioStatusLabel.Text = $"🔊 Audio Output: {audio.DeviceName} [Volume: {muteTxt}]";

            string lockState = _isWindowsLocked ? "LOCKED (Guarding)" : "Unlocked (Ready for Win+L)";
            _lockScreenStatusLabel.Text = $"🔒 Screen State: {lockState} | Sleep-Blocker: {(_state != GuardState.Disarmed ? "ACTIVE" : "Standby")}";
        }

        private void UpdateUiState()
        {
            switch (_state)
            {
                case GuardState.Disarmed:
                    _headerPanel.BackColor = Color.FromArgb(22, 101, 52);
                    _statusBadgeLabel.Text = "🟢 DISARMED — READY";
                    _statusSubLabel.Text = "Plug in your charger, set your PIN, and click 'Arm & Lock Screen' before going to WC.";
                    _btnArmAndLock.Enabled = true;
                    _btnArmOnly.Enabled = true;
                    _btnTestSiren.Enabled = true;
                    _btnDisarm.Enabled = false;
                    _chkAntiMute.Enabled = true;
                    _chkHeadphoneTrap.Enabled = true;
                    _chkAutoLockOnArm.Enabled = true;
                    _chkAutoLockOnTrigger.Enabled = true;
                    _chkAutoDisarmOnWinUnlock.Enabled = true;
                    if (_iconDisarmed != null)
                    {
                        Icon = _iconDisarmed;
                        _trayIcon.Icon = _iconDisarmed;
                    }
                    _trayIcon.Text = "CafeGuard: DISARMED";
                    break;

                case GuardState.Armed:
                    _headerPanel.BackColor = Color.FromArgb(30, 64, 175);
                    _statusBadgeLabel.Text = "🛡️ ARMED — GUARDING LAPTOP";
                    _statusSubLabel.Text = "Monitoring AC Charger & Audio Jack on Lock Screen. Enter PIN to disarm.";
                    _btnArmAndLock.Enabled = false;
                    _btnArmOnly.Enabled = false;
                    _btnTestSiren.Enabled = false;
                    _btnDisarm.Enabled = true;
                    _chkAntiMute.Enabled = false;
                    _chkHeadphoneTrap.Enabled = false;
                    _chkAutoLockOnArm.Enabled = false;
                    _chkAutoLockOnTrigger.Enabled = false;
                    _chkAutoDisarmOnWinUnlock.Enabled = false;
                    if (_iconArmed != null)
                    {
                        Icon = _iconArmed;
                        _trayIcon.Icon = _iconArmed;
                    }
                    _trayIcon.Text = "CafeGuard: ARMED (Protected)";
                    _txtPin.Focus();
                    break;

                case GuardState.AlarmTriggered:
                    _headerPanel.BackColor = Color.FromArgb(220, 38, 38);
                    _statusBadgeLabel.Text = "🚨 THEFT ALARM TRIGGERED! 🚨";
                    _statusSubLabel.Text = $"Trigger: {_triggerReason} — Enter secret PIN to silence siren!";
                    _btnArmAndLock.Enabled = false;
                    _btnArmOnly.Enabled = false;
                    _btnTestSiren.Enabled = false;
                    _btnDisarm.Enabled = true;
                    if (_iconAlarm != null)
                    {
                        Icon = _iconAlarm;
                        _trayIcon.Icon = _iconAlarm;
                    }
                    _trayIcon.Text = "CafeGuard: 🚨 ALARM TRIGGERED!";
                    RestoreFromTray();
                    TopMost = true;
                    _txtPin.Focus();
                    break;
            }
        }

        private void MinimizeToTray()
        {
            Hide();
            _trayIcon.ShowBalloonTip(
                1500,
                "CafeGuard Running in System Tray",
                _state == GuardState.Disarmed
                    ? "Right-click the tray icon anytime to Arm & Lock Screen."
                    : "CafeGuard is actively guarding your laptop in the background.",
                ToolTipIcon.Info);
        }

        private void RestoreFromTray()
        {
            Show();
            WindowState = FormWindowState.Normal;
            BringToFront();
            Activate();
        }

        private void Log(string message)
        {
            string line = $"[{DateTime.Now:HH:mm:ss}] {message}";
            _logBox.Items.Insert(0, line);
            if (_logBox.Items.Count > 100)
            {
                _logBox.Items.RemoveAt(_logBox.Items.Count - 1);
            }
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            // Prevent a thief from closing the window with Alt+F4 or clicking 'X' while Armed or Alarming!
            if (_state != GuardState.Disarmed && e.CloseReason == CloseReason.UserClosing)
            {
                e.Cancel = true;
                Log("⚠️ Blocked window close attempt while Armed! Enter PIN to disarm first.");
                if (_state == GuardState.Armed)
                {
                    MinimizeToTray();
                }
                return;
            }

            base.OnFormClosing(e);
        }

        private void ExitApplication()
        {
            SystemEvents.SessionSwitch -= SystemEvents_SessionSwitch;
            _monitorTimer.Stop();
            _siren.Dispose();
            PowerAndLockService.SetKeepAwakeOnLockScreen(false);
            _trayIcon.Visible = false;
            _trayIcon.Dispose();
            Application.Exit();
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                SystemEvents.SessionSwitch -= SystemEvents_SessionSwitch;
                _monitorTimer?.Dispose();
                _testSirenTimer?.Dispose();
                _siren?.Dispose();
                _trayIcon?.Dispose();
                _trayMenu?.Dispose();
            }
            base.Dispose(disposing);
        }
    }
}
